{
    "name": "raxos/workspace",
    "description": "Development and test workspace for the Raxos libraries.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "./*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "opis/json-schema": "^2.6",
        "pestphp/pest": "^5.0",
        "psr/container": "^2.0",
        "raxos/barcode": "^3.3",
        "raxos/cache": "^3.3",
        "raxos/collection": "^3.3",
        "raxos/container": "^3.3",
        "raxos/contract": "^3.3",
        "raxos/database": "^3.3",
        "raxos/datetime": "^3.3",
        "raxos/error": "^3.3",
        "raxos/foundation": "^3.3",
        "raxos/http": "^3.3",
        "raxos/mail": "^3.3",
        "raxos/message-bus": "^3.3",
        "raxos/oauth2": "^3.3",
        "raxos/openapi": "^3.3",
        "raxos/rate-limit": "^3.3",
        "raxos/reflection": "^3.3",
        "raxos/router": "^3.3",
        "raxos/search": "^3.3",
        "raxos/security": "^3.3",
        "raxos/terminal": "^3.3",
        "raxos/wallet": "^3.3",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "pest --compact",
        "test:lint": "@php tools/lint.php",
        "test:types": "phpstan analyse --no-progress"
    }
}
