        - security/src/Jwt/JwtVerificationPolicy.php
        - security/src/Jwt/JwtVerificationKey.php
        - oauth2/src/Server/SecurityProfile.php
        - message-bus/src/QueuePolicy.php
        - message-bus/src/DeliveryOutcome.php
        - tests/Types
